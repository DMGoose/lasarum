# Public overrides (optional; project-config.json contains only public configuration).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
PAGES_BASE=./
# Set to 1 only for local Vite development without cloud login.
# VITE_LOCAL_ONLY=1

# Local Node server only. Never use a VITE_ prefix for any private key.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=nvidia/nemotron-3.5-lightning:free

# Configure these as Supabase Edge Function secrets, not browser variables.
# APP_ORIGINS=https://YOUR-USERNAME.github.io,http://127.0.0.1:5173
